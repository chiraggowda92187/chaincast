    "@prisma/client": "^6.17.1",
    "@solana/web3.js": "^1.98.4",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^7.0.2",
    "@types/ws": "^8.18.1",
    "cookie-parser": "^1.4.7",
