{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "npx tsc -b && node ./dist/utils/getTokenMetadata.js",
    "prisma": "npx prisma generate --schema=src/db/prisma/schema.prisma",
    "dev": "npm run prisma && concurrently \"tsx src/index.ts\" \"tsx src/worker/index.ts\"",
    "build": "npm run prisma && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "startWorker": "node dist/worker/index.js",
    "server": "cross-env NODE_ENV=prod && concurrently \"node dist/index.js\" \"node dist/worker/index.js\""
  },
